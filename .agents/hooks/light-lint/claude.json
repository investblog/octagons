{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.agent-hook=!bash .agents/hooks/light-lint/lint.sh\" agent-hook; exit $LASTEXITCODE"
          }
        ]
      }
    ]
  }
}
